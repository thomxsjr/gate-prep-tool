{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run deploy:ci",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/snapshot.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
